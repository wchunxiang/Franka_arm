<launch>
  <!-- All-in-one: robot + joystick + joystick controller (straight end effector). -->
  <arg name="robot_ip" default="172.16.0.2" />
  <arg name="config" default="$(find arm_control_magnet_straight)/config.json" />

  <include file="$(find arm_control_magnet_straight)/robot_bringup.launch">
    <arg name="robot_ip" value="$(arg robot_ip)" />
  </include>

  <node name="franka_magnet_controller" pkg="arm_control_magnet_straight" type="franka_magnet_controller.py"
        args="--config $(arg config)" output="screen" respawn="false" />
</launch>
